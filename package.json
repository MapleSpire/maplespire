{
  "name": "maplespire",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node server/patch-automerge-peer-sync-state.mjs .",
    "verify:automerge-patch": "node server/patch-automerge-peer-sync-state.mjs --check .",
    "verify:icon-assets": "node scripts/normalize-icon-catalog-assets.mjs --check",
    "predev": "npm run verify:automerge-patch && npm run verify:icon-assets",
    "prebuild": "npm run verify:automerge-patch && npm run verify:icon-assets",
    "pretest": "npm run verify:automerge-patch && npm run verify:icon-assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild:image": "npm run verify:automerge-patch && npm run verify:icon-assets",
    "build:image": "tsc -p tsconfig.image.json && vite build",
    "verify:same-origin-dist": "node scripts/verify-same-origin-dist.mjs",
    "verify:prometheus-config": "node scripts/prometheus-config-freshness.mjs",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint . && npm run verify:license-headers",
    "verify:license-headers": "node scripts/verify-license-headers.mjs",
    "license:headers:fix": "node scripts/apply-license-headers.mjs",
    "test:license-headers": "node --test scripts/license-header.test.mjs",
    "test:source-nul": "node --test scripts/source-nul.test.mjs",
    "test:maplespire-compose": "node --test scripts/maplespire-compose.test.mjs scripts/quickstart-compose.test.mjs scripts/microsoft-identity-association.test.mjs",
    "test:readiness-consumers": "node --test scripts/readiness-consumers.test.mjs",
    "test:monitoring": "node --test scripts/monitoring.test.mjs scripts/prometheus-config-freshness.test.mjs scripts/alerting-config.test.mjs scripts/deadman-contract.test.mjs",
    "test:alert-delivery": "node --test --test-concurrency=1 scripts/alerting-delivery.test.mjs",
    "test:ci-diagnostics": "node --test scripts/check-test-skips.test.mjs scripts/failing-files.test.mjs scripts/ci-local-parity.test.mjs scripts/ci-local-guard.test.mjs scripts/ci-local-postgres.test.mjs scripts/deploy-startup-pairs.test.mjs scripts/test-citations.test.mjs scripts/gate-liveness.test.mjs scripts/sync-bench-posture.test.mjs scripts/dependency-outage-doors.test.mjs scripts/m7-controls.test.mjs scripts/maintenance-wiring.test.mjs scripts/workflow-text.test.mjs scripts/sync-gate-wiring.test.mjs scripts/nginx-retry-policy.test.mjs",
    "test:automerge-patch": "node --test server/patch-automerge-peer-sync-state.test.mjs server/automerge-bulk-load.test.mjs server/automerge-change-observers.test.mjs server/automerge-document-saves.test.mjs server/automerge-sync-state-lifetime.test.mjs",
    "test:env-knobs": "node --test scripts/env-knobs.test.mjs",
    "test:tech-icons": "node --test scripts/tech-icons/tech-icons.test.mjs scripts/tech-icons/tech-icons-review.test.mjs",
    "tech-icons:audit": "node scripts/tech-icons/audit.mjs",
    "tech-icons:discover": "node scripts/tech-icons/discover.mjs",
    "tech-icons:add": "node scripts/tech-icons/add.mjs",
    "test:harness-suites": "node scripts/run-harness-suites.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:local:down": "node scripts/ci-local.mjs --down",
    "test:skips": "node scripts/check-test-skips.mjs --report reports/vitest-frontend.json --report reports/vitest-server.json",
    "e2e": "playwright test",
    "e2e:boot": "playwright test --project=boot",
    "e2e:model-cache-scale": "playwright test -c playwright.model-cache-scale.config.ts",
    "e2e:rendered-list": "playwright test -c playwright.rendered-list.config.ts",
    "e2e:offline-download": "playwright test -c playwright.offline-download.config.ts",
    "dev:boot": "node scripts/dev-boot.mjs",
    "dev:boot:fresh": "node scripts/dev-boot.mjs --reseed",
    "preview": "vite preview",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run db:up\" \"npm run dev:server\" \"npm run dev\"",
    "dev:local": "concurrently \"npm run db:embedded\" \"npm run dev:server\" \"npm run dev\"",
    "db:embedded": "cd server && npm run db:embedded",
    "seed:performance": "cd server && npm run seed:performance --",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.16",
    "@automerge/automerge": "^3.2.6",
    "@automerge/automerge-repo": "2.6.0-alpha.2",
    "@automerge/automerge-repo-network-websocket": "2.6.0-alpha.2",
    "@automerge/automerge-repo-react-hooks": "2.6.0-alpha.2",
    "@automerge/automerge-repo-storage-indexeddb": "2.6.0-alpha.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.1",
    "@tanstack/react-virtual": "^3.14.3",
    "ai": "^7.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.8",
    "elkjs": "^0.11.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.2.2",
    "immer": "^11.1.8",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.5",
    "n8ao": "^2.0.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^16.6.6",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "troika-three-text": "^0.52.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.1",
    "cbor-x": "^1.6.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.9"
  }
}
