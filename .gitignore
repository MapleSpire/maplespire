# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Playwright MCP test artifacts
.playwright-mcp/

# Embedded Postgres data dir (npm run db:embedded)
server/.pgdata/

# Content-addressed technology icon uploads (runtime data / shared Docker volume)
/data/technology-assets/
/server/data/technology-assets/
/data/backup-drills/

# QA harness transient root pointer
server/qa/last-root.txt

# Playwright E2E outputs
test-results/
playwright-report/

# Vitest reports, and the per-run directories `npm run ci:local` keeps
# (reports/<run-id>/: console output of every step + JSON and JUnit reports).
# Anchored on the whole tree deliberately: a run that goes red must be able to
# leave its evidence on disk without the next person seeing a dirty worktree.
reports/

# Auto-layout SVG previews (generated)
preview/

# Vision-QA artifacts (generated). ANCHORED: an unanchored `qa/` also swallows
# `server/qa/`, the tracked sync-load harness. Its existing files survived only
# because they predate this rule — git does not apply ignores to tracked paths —
# so every NEW harness file was silently invisible to `git add`.
/qa/
.blueprints/

# Infrastructure tool working directories and generated plans
**/cdk.out/
**/.terraform/
*.tfplan
crash.log
.probes/

# The Prometheus scrape token. Written by `node scripts/init-env.mjs`;
# mounted into the prometheus container as a file so it never reaches the
# committed config or a URL.
infra/monitoring/metrics-token
# Local observer addresses generated from the dedicated SNS configuration.
infra/monitoring/deadman-observer.json
