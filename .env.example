# MapleSpire — environment for compose.quickstart.yml (and compose.maplespire.yml)
#
#   1. node scripts/init-env.mjs        (copies this file to .env, generates secrets)
#   2. edit .env if you need SSO, real email, a public URL, ...
#   3. docker compose -f compose.quickstart.yml up -d --build
#
# .env is gitignored. Never commit real values. Guide: docs/getting-started.md

# ── Generated secrets (left empty here; init-env.mjs fills them) ─────────────
MAPLESPIRE_POSTGRES_PASSWORD=
# Signs session cookies and derives the key that encrypts stored AI provider keys.
# Changing it logs everybody out and makes stored AI keys unreadable.
MAPLESPIRE_AUTH_SECRET=
MAPLESPIRE_GRAFANA_ADMIN_PASSWORD=
# Bearer token shared by the API /metrics endpoint and Prometheus.
MAPLESPIRE_METRICS_TOKEN=

# ── Public address ───────────────────────────────────────────────────────────
# The URL users type in their browser. Used in emails, OAuth redirects and
# share links. Keep the default for a local test.
MAPLESPIRE_APP_URL=http://localhost:8088
# Host port of the web front end (bound to 127.0.0.1 only).
MAPLESPIRE_WEB_PORT=8088
# Secure session cookies. Browsers accept them on http://localhost; set to "off"
# only if you serve plain HTTP on another host name (not recommended).
MAPLESPIRE_AUTH_COOKIE_SECURE=on

# ── First administrator ──────────────────────────────────────────────────────
# The account registered with this address becomes platform administrator.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# ── Email (account confirmation, invitations) ────────────────────────────────
# local      : nothing is sent; messages are viewable at <APP_URL>/api/dev/outbox
#              (fine for a local test, NEVER on a public host)
# ses        : Amazon SES — needs AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# cloudflare : Cloudflare Email Service — needs CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_EMAIL_API_TOKEN
EMAIL_PROVIDER=local
# Verified sender, e.g. MapleSpire <no-reply@your-domain.example>
EMAIL_FROM=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# ── Optional single sign-on ──────────────────────────────────────────────────
# Redirect URIs: <APP_URL>/api/auth/callback/google and <APP_URL>/api/auth/callback/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=
# Microsoft publisher-domain verification: set to your app registration's
# application (client) ID to serve /.well-known/microsoft-identity-association.json.
# Empty = off (the URL answers 404).
MS_IDENTITY_ASSOCIATION_APP_ID=

# ── Optional AI assistant endpoints ──────────────────────────────────────────
# Hosted providers (OpenAI, Anthropic, Google) need nothing here. A custom
# endpoint (LM Studio, any OpenAI-compatible server) must be listed exactly,
# comma-separated, or the admin console refuses it. A model server running on
# this machine is reached from the containers as host.docker.internal, e.g.
#   AI_ALLOWED_BASE_URLS=http://host.docker.internal:1234/v1
AI_ALLOWED_BASE_URLS=

# ── Optional profiles ────────────────────────────────────────────────────────
# Comma-separated: "tunnel" (Cloudflare tunnel), "alerting" (Alertmanager).
COMPOSE_PROFILES=

# Profile "tunnel": token from the Cloudflare Zero Trust tunnel page.
CLOUDFLARE_TUNNEL_TOKEN=

# Profile "alerting": see maplespire-sponsor-kit/docs/operations/alerting-smtp.md and alerting-sns.md
MAPLESPIRE_ALERT_SMTP_REGION=
MAPLESPIRE_ALERT_SMTP_USERNAME=
MAPLESPIRE_ALERT_SMTP_PASSWORD=
MAPLESPIRE_ALERT_EMAIL_FROM=
MAPLESPIRE_ALERT_EMAIL_TO=
MAPLESPIRE_ALERT_SNS_REGION=
MAPLESPIRE_ALERT_SNS_ACCESS_KEY_ID=
MAPLESPIRE_ALERT_SNS_SECRET_ACCESS_KEY=
MAPLESPIRE_ALERT_SNS_WATCHDOG_TOPIC_ARN=
MAPLESPIRE_ALERT_SNS_NOTIFICATION_TOPIC_ARN=

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# MAPLESPIRE_GRAFANA_PORT=3030
# MAPLESPIRE_METRICS_RETENTION_SIZE=4GB
# MAPLESPIRE_DRILL_INTERVAL_HOURS=24
# MAPLESPIRE_DRILL_COLD_API=on
# MAPLESPIRE_DRILL_SIGNING_KEY=
# MAPLESPIRE_DRILL_SIGNING_KEY_ID=maplespire-home
# MAPLESPIRE_DRILL_HISTORY_MAX_BYTES=64MB
# MAPLESPIRE_BACKUP_BUNDLE_MAX_BYTES=20GB
